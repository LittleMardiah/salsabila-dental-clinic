generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Patient {
  id            Int            @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  keluhan       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  medicalVisits MedicalVisit[]
  queues        Queue[]
  transactions  Transaction[]
}

model Queue {
  id                  Int                  @id @default(autoincrement())
  date                DateTime             @db.Date
  queueNumber         Int
  patientId           Int
  status              QueueStatus          @default(WAITING)
  patientCode         String?              @unique
  codeExpiresAt       DateTime?
  calledAt            DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  medicalVisits       MedicalVisit?
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  transactions        Transaction?
  webPushSubscription webPushSubscription?

  @@unique([date, queueNumber])
  @@index([date])
  @@index([status])
  @@index([patientCode])
}

model webPushSubscription {
  id        Int      @id @default(autoincrement())
  queueId   Int      @unique
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  queue     Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
}

model MedicalVisit {
  id                    Int            @id @default(autoincrement())
  patientId             Int
  queueId               Int            @unique
  keluhanUtama          String?
  diagnosa              String
  tindakan              String
  resepObat             String?
  catatanTambahan       String?
  dokterPenanggungJawab String
  followUpDate          DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  photos                MedicalPhoto[]
  patient               Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  queue                 Queue          @relation(fields: [queueId], references: [id], onDelete: Cascade)
}

model MedicalPhoto {
  id         Int          @id @default(autoincrement())
  visitId    Int
  fileUrl    String
  fileName   String
  uploadedAt DateTime     @default(now())
  visit      MedicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model Transaction {
  id            Int                @id @default(autoincrement())
  queueId       Int                @unique
  patientId     Int
  amount        Float?
  receiptUrl    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  confirmedAt   DateTime?
  paymentMethod PaymentMethod?
  status        TransactionStatus? @default(PENDING)
  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  queue         Queue              @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model DailyReconciliation {
  id            Int      @id @default(autoincrement())
  date          DateTime @unique @db.Date
  totalRecorded Float
  notes         String?
  reconciledAt  DateTime @default(now())
  adminId       String

  @@index([date])
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  adminId          String
  actionType       String
  recordType       String
  recordId         String
  technicalDetails Json?
  ipAddress        String?
  createdAt        DateTime @default(now())
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
}

enum QueueStatus {
  WAITING
  CALLED
  COMPLETED
}
