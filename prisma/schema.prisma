generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Patient {
  id            Int            @id @default(autoincrement())
  /// Clinic medical record number, format RM-YYYY-XXXX. Shown in Admin and PWA.
  noRm          String?        @unique
  name          String
  phone         String?
  email         String?
  dateOfBirth   DateTime?      @db.Date
  allergies     String?
  keluhan       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  medicalVisits MedicalVisit[]
  queues        Queue[]
  transactions  Transaction[]
  account       PatientAccount?
}

/// Login account for the patient PWA. One patient may have at most one account;
/// walk-in patients created by the clinic stay usable before they register.
model PatientAccount {
  id                  Int       @id @default(autoincrement())
  patientId           Int       @unique
  email               String    @unique
  passwordHash        String
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  resetAttempts       Int       @default(0)
  /// Incremented on logout / password reset to revoke every issued JWT.
  sessionVersion      Int       @default(0)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  patient             Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([resetTokenHash])
}

/// Fixed-window counters shared by every serverless instance. Keys are hashed
/// IP/identifier values so the table never stores raw credentials or contact data.
model RateLimitBucket {
  id          Int      @id @default(autoincrement())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@unique([key, windowStart])
  @@index([expiresAt])
}

model Queue {
  id                  Int                  @id @default(autoincrement())
  date                DateTime             @db.Date
  queueNumber         Int
  patientId           Int
  status              QueueStatus          @default(WAITING)
  patientCode         String?              @unique
  codeExpiresAt       DateTime?
  calledAt            DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  medicalVisits       MedicalVisit?
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  transactions        Transaction?
  webPushSubscription webPushSubscription?

  @@unique([date, queueNumber])
  @@index([date])
  @@index([status])
  @@index([patientCode])
}

model webPushSubscription {
  id        Int      @id @default(autoincrement())
  queueId   Int      @unique
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  queue     Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
}

model MedicalVisit {
  id                    Int            @id @default(autoincrement())
  patientId             Int
  queueId               Int            @unique
  keluhanUtama          String?
  diagnosa              String
  tindakan              String
  resepObat             String?
  catatanTambahan       String?
  dokterPenanggungJawab String
  followUpDate          DateTime?
  /// Optional clinic time label for the follow-up (e.g. "16:00 – 16:30 WIB").
  followUpTime          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  photos                MedicalPhoto[]
  patient               Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  queue                 Queue          @relation(fields: [queueId], references: [id], onDelete: Cascade)
}

model MedicalPhoto {
  id         Int          @id @default(autoincrement())
  visitId    Int
  fileUrl    String
  fileName   String
  uploadedAt DateTime     @default(now())
  fileId     String?
  visit      MedicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model Transaction {
  id            Int                @id @default(autoincrement())
  queueId       Int                @unique
  patientId     Int
  amount        Float?
  receiptUrl    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  confirmedAt   DateTime?
  paymentMethod PaymentMethod?
  status        TransactionStatus? @default(PENDING)
  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  queue         Queue              @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model DailyReconciliation {
  id            Int      @id @default(autoincrement())
  date          DateTime @unique @db.Date
  totalRecorded Float
  notes         String?
  reconciledAt  DateTime @default(now())
  adminId       String

  @@index([date])
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  adminId          String
  actionType       String
  recordType       String
  recordId         String
  technicalDetails Json?
  ipAddress        String?
  createdAt        DateTime @default(now())
}

/// Singleton row (id = 1) holding the real operational status of the clinic.
model ClinicStatus {
  id        Int      @id @default(1)
  isOpen    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AdminPreference {
  adminId            String    @id
  hiddenMenus        String[]  @default([])
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime? @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @db.Timestamptz(6)
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
}

enum QueueStatus {
  WAITING
  CALLED
  COMPLETED
}

