DATABASE_URL="xxxx"

# Supabase
PROJECT_URL="xxxx"
NEXT_PUBLIC_SUPABASE_URL="xxxx"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxx"

# JWT — wajib >= 32 karakter acak di production. Jangan commit nilai asli.
JWT_SECRET="Ambil dari Supabase"

# Email (Resend)
RESEND_API_KEY="Buat di Resend.com"

# Cron
CRON_SECRET_TOKEN="Buat di Terminal openhash ssl"

# Patient PWA (uji coba)
# true = tombol akun demo aktif. OTP demo hanya ditampilkan di non-production.
# Set false saat demo ditutup (akun demo & OTP demo dinonaktifkan).
PATIENT_DEMO_ENABLED="true"

# Admin dua lapis — WAJIB diisi dengan nilai acak/kuat di production.
# Layer 1: kode 8 digit (atau bcrypt hash). Layer 2: username + password hash.
ADMIN_ACCESS_CODE="ganti-dengan-kode-8-digit-acak"
ADMIN_USERNAME="admin"
# Base64 dari bcrypt hash password admin. Wajib di production.
ADMIN_PASSWORD_HASH_BASE64=""

# Web Push VAPID 
VAPID_PUBLIC_KEY="xxxx"
VAPID_PRIVATE_KEY="xxxx"

# Google Drive OAuth (backup)
NEXTAUTH_URL="https://salsabila-dental-clinic.vercel.app"
GOOGLE_CLIENT_ID="xxxx"
GOOGLE_CLIENT_SECRET="xxxx"
GOOGLE_REDIRECT_URI="https://salsabila-dental-clinic.vercel.app/api/backup/google-callback"
# Opsional; default ke JWT_SECRET untuk enkripsi state OAuth
GOOGLE_OAUTH_STATE_SECRET="xxxx"
